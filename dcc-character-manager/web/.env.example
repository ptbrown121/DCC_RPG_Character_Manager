# Copy to .env.local and fill in from your Supabase dashboard:
# Project Settings → API Keys (the new key system, not the legacy JWT anon key).
# Use the PUBLISHABLE key (sb_publishable_...) here — never the secret key
# (sb_secret_...), which is server-only and must not appear in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
